# Copy to .env; values are loaded by the CLI, never stored in learning state.
ALGOCOACH_MODEL=deepseek-flash
ALGOCOACH_API_KEY=
# Official DeepSeek API, using its OpenAI-compatible endpoint.
# Other providers: change the model and endpoint together.
ALGOCOACH_BASE_URL=https://api.deepseek.com
ALGOCOACH_MODEL_PROVIDER=openai
ALGOCOACH_DATA_DIR=.algo-coach
# Explicitly enable only after configuring Docker and building the runner image.
ALGOCOACH_RUNNER_ENABLED=false
ALGOCOACH_RUNNER_IMAGE=algo-coach-runner:0.1
# Existing independent practice directory. Never point this at the application repository.
ALGOCOACH_PRACTICE_DIR=
# export_only / commit_on_request / push_on_request; writes always need explicit apply.
ALGOCOACH_GIT_POLICY=export_only
# Experimental CN platform submission. Keep credentials local; never paste into chat.
# Read-only platform doctor/preview work without enabling submissions.
ALGOCOACH_PLATFORM_SUBMIT_ENABLED=false
ALGOCOACH_LEETCODE_SESSION=
ALGOCOACH_LEETCODE_CSRF=
